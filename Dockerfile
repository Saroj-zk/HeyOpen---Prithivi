# syntax=docker/dockerfile:1.7

# ===================================================================
# HeyOpen landing site
#
# Four stages, two of them you can actually run:
#
#   runner  the production image. Next's traced standalone server,
#           serving the 12 prerendered pages and public/.
#   dev     `next dev` with hot reload, for compose's dev profile.
#
#   deps    npm ci, cached on the lockfile alone.
#   builder `next build`.
#
# Build the production image:   docker build -t heyopen-site .
# Build the dev image:          docker build --target dev -t heyopen-site:dev .
#
# Or let compose do both: see docker-compose.yml.
# ===================================================================

ARG NODE_VERSION=20-alpine


# ---- base ---------------------------------------------------------
# One place where the runtime is chosen, so the stage that builds the
# SWC artifacts and the stage that runs them can never disagree.
FROM node:${NODE_VERSION} AS base

# Next's SWC binary is linked against glibc symbols that Alpine's musl
# does not provide on its own. This is the shim, and it is why the build
# does not fall back to the much slower Babel path.
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Nothing phones home from inside a container.
ENV NEXT_TELEMETRY_DISABLED=1


# ---- deps ---------------------------------------------------------
# Only the two dependency files are copied, so this layer is reused for
# every build where the lockfile has not moved, which is most of them.
#
# npm ci, not npm install: it installs exactly the lockfile and fails if
# package.json has drifted from it, rather than quietly resolving
# something new inside an image nobody is watching.
FROM base AS deps

COPY package.json package-lock.json ./
RUN npm ci


# ---- builder ------------------------------------------------------
# `next build` writes two things this image cares about:
#
#   .next/standalone  the server plus the traced subset of node_modules
#   .next/static      the hashed client chunks
#
# Everything else under .next is build scratch and is left behind here.
FROM base AS builder

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NODE_ENV is set for the build itself: it is what puts React into its
# production build and strips the development-only warnings.
ENV NODE_ENV=production
RUN npm run build


# ---- dev ----------------------------------------------------------
# The development server. Compose bind mounts the working tree over
# /app, so what is baked in here is really just node_modules: a Linux
# install of it, which is the point, since the host's is macOS arm64.
#
# Next 12 binds dev to 0.0.0.0 already, so there is no host flag to pass
# for the port mapping to work.
FROM base AS dev

ENV NODE_ENV=development
COPY --from=deps /app/node_modules ./node_modules
COPY . .

EXPOSE 3000

# The binary directly rather than `npm run dev`: npm sits between Docker
# and the server as PID 1's child and does not pass SIGTERM along, so a
# `docker stop` through npm waits the full ten seconds and then kills it.
CMD ["./node_modules/.bin/next", "dev"]


# ---- runner -------------------------------------------------------
# Production. No npm, no build toolchain, no source: the traced server,
# the client chunks, and public/.
FROM base AS runner

ENV NODE_ENV=production
ENV PORT=3000

# public/ is 150MB of video and imagery and changes rarely, so it is
# copied before the build output. That ordering keeps it in a layer that
# survives a code change, and a rebuild after editing a component pushes
# only the few MB that actually moved.
COPY --from=builder --chown=node:node /app/public ./public

# standalone already contains its own package.json and node_modules.
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

# The node user ships with the image at uid 1000. Nothing here writes to
# disk at runtime, so the server has no business running as root.
USER node

EXPOSE 3000

# Hits the real home page, not a port check: the process can be up and
# listening while the server itself is failing to render.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/" || exit 1

# server.js is generated by the standalone build. It already traps
# SIGTERM and SIGINT, so it is safe as PID 1 and `docker stop` is
# immediate.
CMD ["node", "server.js"]
